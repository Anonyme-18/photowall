# Local development only. Never commit a real value.

# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# UploadThing server token (server-side only)
UPLOADTHING_TOKEN=replace_with_uploadthing_token

# Admin access
ADMIN_PIN=replace_with_a_long_unique_pin
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Only required by the one-time migration script:
# SUPABASE_MIGRATION_URL=https://your-project.supabase.co
# SUPABASE_MIGRATION_SERVICE_ROLE_KEY=replace_with_old_supabase_service_role_key
